{
  "name": "nsgplayer-react",
  "private": true,
  "version": "1.0.0",
  "description": "NSG Player sample — React + Vite (no BFF, sourceUrl playground)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codenkay/video-nsgplayer-core": "^3.0.4",
    "@codenkay/video-nsgplayer-react": "^3.0.4",
    "@codenkay/video-nsgplayer-ui": "^3.0.4",
    "hls.js": "^1.6.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
